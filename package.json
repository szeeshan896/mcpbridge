{
  "name": "@mcpbridgeapp/cli",
  "version": "0.1.0",
  "description": "Let any AI app (claude.ai, ChatGPT, Claude Code, your phone) hand work to the AI CLIs and models on your own computer, over MCP, with no keys on any server",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai",
    "agent",
    "claude",
    "claude-code",
    "codex",
    "grok",
    "gemini",
    "antigravity",
    "deepseek",
    "ollama",
    "delegation",
    "relay"
  ],
  "license": "MIT",
  "author": "Syed Zeeshan Ali",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/szeeshan896/mcpbridgeapp.git"
  },
  "homepage": "https://mcpbridge.app",
  "type": "module",
  "bin": {
    "mcpbridgeapp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "prepare": "npm run build",
    "test": "tsc --noEmit && node --test --test-timeout=60000 --test-force-exit --import tsx \"test/**/*.test.ts\"",
    "start": "tsx src/index.ts",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "22.19.5",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "@types/ws": "8.18.2"
  },
  "exports": {
    ".": "./dist/index.js",
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "default": "./dist/protocol.js"
    },
    "./connect": {
      "types": "./dist/connect.d.ts",
      "default": "./dist/connect.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "default": "./dist/tools.js"
    },
    "./registry": {
      "types": "./dist/agents/registry.d.ts",
      "default": "./dist/agents/registry.js"
    },
    "./tasks": {
      "types": "./dist/tasks.d.ts",
      "default": "./dist/tasks.js"
    },
    "./limit": {
      "types": "./dist/limit.d.ts",
      "default": "./dist/limit.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    }
  },
  "bugs": {
    "url": "https://github.com/szeeshan896/mcpbridgeapp/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
